# Ficheiros auxiliares do LaTeX (gerados a cada compilação)
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc

# PDF gerado na raiz ao compilar no editor; o oficial é build/artigo.pdf
/artigo.pdf

# O .gitignore da raiz do repositório ignora todas as pastas build/.
# Aqui guarda-se o PDF compilado (e só ele), para quem não tem LaTeX.
!/build/
/build/*
!/build/artigo.pdf
